<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1, non net472: da Unity 6.3 le assembly di Arena sono
         compilate contro netstandard 2.1, e un target net472 porta con se'
         il facade 2.0 che l'SDK preferisce d'ufficio a qualunque reference
         esplicita (CS1705 su UnityEngine.ImageConversionModule). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MTGAEnhancementSuite</AssemblyName>
    <RootNamespace>MTGAEnhancementSuite</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Versione dell'assembly, non solo della mod.

         Windows Installer non sostituisce un file la cui versione e' uguale o
         inferiore a quella gia' installata. Senza queste righe ogni build usciva
         come 1.0.0.0, identica alla precedente, e l'MSI aggiornava BepInEx ma
         lasciava intatta la mod: un utente che gia' l'aveva restava con quella
         vecchia senza nessun avviso.

         Sta nello spazio 1.x e non 0.19 perche' le build passate hanno gia'
         spedito 1.0.0.0: partire da 0.19.0.0 sarebbe un numero piu' basso, e
         l'installatore rifiuterebbe l'aggiornamento per la stessa ragione. La
         versione pubblica della mod resta quella in PluginInfo.VERSION. -->
    <Version>1.25.0</Version>
    <FileVersion>1.25.0.0</FileVersion>
    <AssemblyVersion>1.25.0.0</AssemblyVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- BepInEx core -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assemblies (never ship these) -->
  <ItemGroup>
    <Reference Include="SharedClientCore">
      <HintPath>$(MTGAManaged)\SharedClientCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(MTGAManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Input System package. Da Unity 6.3 Arena ha l'active input handling
         impostato su questo, e UnityEngine.Input (InputLegacyModule) lancia a
         runtime: la reference legacy e' stata tolta apposta, cosi' un uso
         accidentale non compila invece di rompersi in gioco. -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(MTGAManaged)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MTGAManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- GRE protocol types (TimerType, Phase, Step, TimerBehavior...).
         Needed since we read duel state. -->
    <Reference Include="Wizards.MDN.GreProtobuf">
      <HintPath>$(MTGAManaged)\Wizards.MDN.GreProtobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- I campi ripetuti dei messaggi GRE (per esempio
         Attacker.LegalDamageRecipients) sono RepeatedField<T>, che vive qui:
         senza questa reference non si puo' nemmeno scorrerli con foreach. -->
    <Reference Include="Google.Protobuf">
      <HintPath>$(MTGAManaged)\Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Core">
      <HintPath>$(MTGAManaged)\Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MTGAManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MTGAManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MTGAManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(MTGAManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MTGAManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MTGAManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MTGAManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(MTGAManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BouncyCastle.Crypto">
      <HintPath>$(MTGAManaged)\BouncyCastle.Crypto.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(MTGAManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(MTGAManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(MTGAManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Used by IconBootstrapper to unzip the icons asset downloaded from GitHub releases. -->
    <Reference Include="System.IO.Compression">
      <HintPath>$(MTGAManaged)\System.IO.Compression.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem">
      <HintPath>$(MTGAManaged)\System.IO.Compression.FileSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Il visualizzatore dei replay.

       E' la pagina React che `viewer/` costruisce in un file solo
       (vite-plugin-singlefile) e che `ReplayExporter` riempie coi dati di un
       match. Va incorporata nell'assembly, non spedita accanto: un file
       accanto si perde, si aggiorna a meta', e un utente che copia solo la DLL
       si ritrova un pulsante che non fa niente.

       **L'HTML costruito e' committato apposta**, cosi' `dotnet build` non
       richiede Node. Chi tocca `viewer/` deve rifare `npm run build` e
       committare il risultato; chi tocca solo il C# non deve avere Node. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\replay-viewer.html"
                      LogicalName="MTGAEnhancementSuite.Resources.replay-viewer.html" />
  </ItemGroup>

  <Target Name="VerifyReplayViewer" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Resources\replay-viewer.html')"
           Text="Manca Plugin\Resources\replay-viewer.html. Costruiscilo: cd viewer; npm install; npm run build" />
  </Target>

</Project>
